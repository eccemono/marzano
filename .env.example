# Copy to .env and fill with YOUR values.
# NEVER commit a real .env file or a real bot token.

# ── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token.
# Enter this directly on the server; never paste it into chat or a commit.
DISCORD_TOKEN=your_bot_token_here

# Application (client) ID from the Developer Portal -> General Information.
CLIENT_ID=1549548366864584744

# Optional: register slash commands in a single guild for instant updates while
# developing. Leave unset for global command registration.
# DEV_GUILD_ID=

# ── Runtime ────────────────────────────────────────────────────────────────
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Directory for the SQLite database and other runtime state.
# Production overrides this to /srv/marzano so data survives redeploys.
DATA_DIR=./data

# Voice and audio
# Path to the ffmpeg binary. Must be installed on the host.
FFMPEG_PATH=ffmpeg
