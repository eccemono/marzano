{
  "name": "marzano",
  "version": "0.1.0",
  "description": "Marzano - a Discord Pomodoro bot for voice channels: shared focus and break cycles with per-channel configuration and in-VC session control.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "pomodoro",
    "productivity",
    "voice"
  ],
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
